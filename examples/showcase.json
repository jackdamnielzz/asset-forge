{
  "commands": [
    { "command": "clear_scene" },
    { "command": "set_environment", "args": { "lighting": "studio" } },
    { "command": "set_style", "args": { "style": "realistic" } },
    { "command": "set_effects", "args": { "ao": true, "bloom": true, "bloomThreshold": 2.5 } },
    { "command": "add_object", "args": { "type": "box", "name": "floor", "position": [0, -0.05, 0], "params": { "width": 5, "height": 0.1, "depth": 3.2, "bevel": 0.02 }, "material": { "preset": "cobblestone" } } },
    { "command": "add_object", "args": { "type": "box", "name": "wall", "position": [0, 1.0, -1.45], "params": { "width": 5, "height": 2.1, "depth": 0.3, "bevel": 0.02 }, "material": { "preset": "brick_wall" } } },
    { "command": "make_crate", "args": { "position": [-1.5, 0, -0.5], "size": 0.9, "metalCorners": true, "seed": 4, "wear": 0.35 } },
    { "command": "add_object", "args": { "type": "cylinder", "name": "barrel", "position": [-0.25, 0.55, -0.7], "params": { "radiusTop": 0.32, "radiusBottom": 0.32, "height": 1.0 }, "material": { "preset": "rusty_metal" } } },
    { "command": "add_object", "args": { "type": "box", "name": "cushion", "position": [0.8, 0.12, 0.4], "params": { "width": 0.8, "height": 0.22, "depth": 0.8, "bevel": 0.1, "bevelSegments": 6 }, "material": { "preset": "cloth" } } },
    { "command": "add_object", "args": { "type": "sphere", "name": "steel_ball", "position": [0.8, 0.5, 0.4], "params": { "radius": 0.28 }, "material": { "preset": "brushed_steel" } } },
    { "command": "add_object", "args": { "type": "box", "name": "old_plank", "position": [1.6, 0.06, -0.3], "rotation": [0, 25, 0], "params": { "width": 1.3, "height": 0.08, "depth": 0.25, "bevel": 0.015 }, "material": { "preset": "old_wood" } } },
    { "command": "add_object", "args": { "type": "cone", "name": "crystal", "position": [1.75, 0.45, 0.6], "params": { "radius": 0.16, "height": 0.7, "segments": 6 }, "material": { "preset": "glow", "emissive": "#6fd3ff", "flatShading": true } } },
    { "command": "add_object", "args": { "type": "box", "name": "tile_step", "position": [-0.3, 0.08, 0.8], "params": { "width": 1.2, "height": 0.16, "depth": 0.7, "bevel": 0.02 }, "material": { "preset": "floor_tiles" } } }
  ]
